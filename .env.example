# ==============================================================================
# GREENVERSE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Set these variables in your local environment (.env or .env.local)
# and in your Vercel Project Settings under Settings -> Environment Variables.
#
# IMPORTANT:
# - Use ONLY public/anon or publishable keys in frontend applications.
# - NEVER expose your SUPABASE_SERVICE_ROLE_KEY in frontend or Vercel client envs.
# ==============================================================================

# Supabase Project URL (found under Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Public Key (found under Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# ==============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# (Set these in Supabase Dashboard -> Edge Functions -> Secrets, NOT in .env)
# ==============================================================================
#
# Google Gemini API Key — required for TreeDoctor AI diagnosis
# Get a free key at: https://aistudio.google.com/app/apikey
# Set in Supabase Dashboard: Edge Functions -> tree-diagnosis -> Secrets -> GEMINI_API_KEY
#
# GEMINI_API_KEY=your-gemini-api-key-here
#
# This key is NEVER placed in this .env file or the frontend bundle.
# It lives exclusively as a Supabase Edge Function secret (server-side).

# ==============================================================================
# OPTIONAL: OPEN-METEO WEATHER
# ==============================================================================
# No API key needed — Open-Meteo is 100% free and open.
# Live weather is fetched automatically when users grant browser location access.
# See: https://open-meteo.com/

